\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  \par
     \ul fun\'e7\'e3o\ulnone  divisor(\ul inteiro:\ulnone  num) \ul inteiro\par
\ulnone           \ul inicio\par
\ulnone                \ul inteiro:\ulnone  res;\par
               res \f1\u8592?\f0\lang22  pow(2, num) - 1;\par
               \ul retorna\ulnone  res;\par
          \ul fim;\par
\ulnone      \ul fim-fun\'e7\'e3o.\par
\ulnone      \ul fun\'e7\'e3o\ulnone  fatorial(\ul inteiro:\ulnone  num) \ul inteiro\par
\ulnone           \ul inicio\par
\ulnone                \ul inteiro:\ulnone  res;\par
               res \f1\u8592?\f0\lang22  num;\ul\par
\ulnone                \ul enquanto\ulnone  (num >= 2) \ul fa\'e7a\par
\ulnone                     res \f1\u8592?\f0\lang22  res * --num;\par
               \ul fim-enquanto;\ulnone\par
               \ul retorna\ulnone  res;\par
          \ul fim;\par
\ulnone      \ul fim-fun\'e7\'e3o.\par
\ulnone\{programa-principal\}\par
     \ul in\'edcio\par
\ulnone           \ul inteiro:\ulnone  valorX, numFatorial, exp, num1, num2;\ul\par
\ulnone           \ul real:\ulnone  res \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul para\ulnone  numFatorial \ul de\ulnone  0 \ul at\'e9\ulnone  50 \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\ulnone\par
                    num1 \f1\u8592?\f0\lang22  fatorial(numFatorial);\par
                    num2 \f1\u8592?\f0\lang22  divisor(numFatorial);\par
                    \ul se\ulnone  (numFatorial MOD 2 = 1) \ul ent\'e3o\par
\ulnone                          res \f1\u8592?\f0\lang22  res + (real) num1 / num2;\par
                    \ul sen\'e3o\par
\ulnone                          res = res - (real) num1 / num2;\par
                    \ul fim-se;\ulnone\par
               \ul fim;\par
\ulnone           \ul fim-para;\par
\ulnone           \ul escreva(\ulnone "R = ", res);\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par

\pard\sl276\slmult1 10 - \cf1 Fa\'e7a um programa que leia 10 n\'fameros inteiros positivos, calcule e escreva os que s\'e3o n\'fameros perfeitos. Sendo que, um n\'famero perfeito \'e9 aquele cuja soma de seus divisores, exceto ele pr\'f3prio, \'e9 igual ao n\'famero.\par

\pard\fi568\sl276\slmult1 Exemplo:\par
6 \'e9 perfeito porque 1 + 2 + 3 = 6\par

\pard\fi568\sa200\sl276\slmult1 28 \'e9 perfeito porque 1 + 2 + 4 + 7 + 14 = 28\cf0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  \par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  num, divisor, soma \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul escreva\ulnone ("Informe um n\'famero");\ul\par
\ulnone           \ul leia\ulnone (num);\ul\par
\ulnone           \ul para\ulnone  divisor \ul de\ulnone  1 \ul at\'e9\ulnone  divisor < num \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\ulnone\par
                    \ul se\ulnone  (num MOD divisor = 0) \ul ent\'e3o\ulnone\par
                         soma \f1\u8592?\f0\lang22  soma + divisor;\par
                    \ul fim-se;\ulnone\par
               \ul fim-para;\par
\ulnone           \ul se\ulnone  (soma = num) \ul ent\'e3o\ulnone\par
               \ul escreva\ulnone (num, " \'e9 perfeito!");\par
          \ul sen\'e3o\ulnone\par
               \ul escreva\ulnone (num, " n\'e3o \'e9 perfeito!");\par
          \ul fim-se;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\fs22\par
