\pard\sa200\sl276\slmult1\f0\fs24\lang22 1 - \cf1 Fa\'e7a um programa que leia um n\'famero inteiro e calcule e escreva a tabuada deste n\'famero (usando estrutura de repeti\'e7\'e3o).\cf0\par
\ul algoritmo\ulnone  TABUADA\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  num1, num2;\ul\par
\ulnone           \ul escreva\ulnone ("Informe um n\'famero inteiro!");\ul\par
\ulnone           \ul leia\ulnone (num1);\ul\par
\ulnone           \ul para\ulnone  num2 \ul de\ulnone  1 \ul at\'e9\ulnone  10 \ul passo\ulnone  1 \ul fa\'e7a\ulnone\par
               \ul escreva\ulnone (num1, " * ", num2, " = ", num1 * num2);\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
2 - \cf1 Fa\'e7a um programa em C que escreve os n\'fameros m\'faltiplos de 7 entre 100 e 200, bem como a soma destes n\'fameros. \cf0\par
\ul algoritmo\ulnone  MULTIPLOS_SETE\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  num1, res \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul escreva\ulnone (" Esses s\'e3o os n\'fameros m\'faltiplos de 7 entre 100 e 200");\ul\par
\ulnone           \ul para\ulnone  num1 \ul de\ulnone  105 \ul at\'e9\ulnone  196 \ul passo\ulnone  7 \ul fa\'e7a\ulnone\par
               \ul in\'edcio\ulnone\par
                    \ul escreva\ulnone (num1);\par
                    res \f1\u8592?\f0\lang22  res + num1;\par
               \ul fim-para;\par
\ulnone           \ul escreva\ulnone ("E a soma deles \'e9 ", res);\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
3 - \cf1 Tem-se um conjunto de dados contendo a altura e o sexo (masculino, feminino) de 50 pessoas. Fazer um algoritmo que calcule e escreva: \par

\pard\fi568\sl276\slmult1 a) a maior e a menor altura do grupo;\par
b) a m\'e9dia de altura das mulheres;\par

\pard\fi568\sa200\sl276\slmult1 c) o n\'famero de homens.\cf0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  CONJUTO\par
     \ul inicio\par
\ulnone           \ul caractere:\ulnone  sexo;\ul\par
\ulnone           \ul real:\ulnone  altura, media \f1\u8592?\f0\lang22  0, maiorA \f1\u8592?\f0\lang22  0, menorA \f1\u8592?\f0\lang22 3;\ul\par
\ulnone           \ul inteiro:\ulnone  ciclo, homens \f1\u8592?\f0\lang22  0, mulheres \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul para\ulnone  ciclo \ul de\ulnone  0 \ul at\'e9\ulnone  50 \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\par
\ulnone                     \ul escreva\ulnone ("Informe o seu sexo");\ul\par
\ulnone                     \ul leia\ulnone (sexo);\ul\par
\ulnone                     \ul escreva\ulnone ("Informe a sua altura");\ul\par
\ulnone                     \ul leia\ulnone (altura);\ul\par
\ulnone                     \ul se\ulnone  (sexo = 'F') \ul ent\'e3o\par
\ulnone                          mulheres++;\ul\par
\ulnone                          media \f1\u8592?\f0\lang22  media + altura;\ul\par
\ulnone                          \ul se\ulnone  (altura > maiorA) \ul ent\'e3o\ulnone\par
                              maiorA \f1\u8592?\f0\lang22  altura;\ul\par
\ulnone                          \ul sen\'e3o se\ulnone  (altura < menorA) \ul ent\'e3o\ulnone\par
                              menorA \f1\u8592?\f0\lang22  altura;\ul\par
\ulnone                          \ul fim-se;\ulnone\par
                    \ul sen\'e3o se\ulnone  (sexo = 'M') \ul ent\'e3o\par
\ulnone                          homens++;\ul\par
\ulnone                          \ul se\ulnone  (altura > maiorA) \ul ent\'e3o\ulnone\par
                              maiorA \f1\u8592?\f0\lang22  altura;\par
                         \ul sen\'e3o se\ulnone  (altura < menorA) \ul ent\'e3o\ulnone\par
                              menorA \f1\u8592?\f0\lang22  altura;\par
                         \ul fim-se;\ulnone\par
                    \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone ("Op\'e7\'e3o inv\'e1lida!");\par
                    \ul fim-se;\ulnone\par
               \ul fim-para;\par
\ulnone           \ul escreva\ulnone ("A maior e a menor altura do grupo s\'e3o: ", maiorA, " e ", menorA);\ul\par
\ulnone           \ul escreva\ulnone ("A m\'e9dia de altura das mulheres \'e9 ", (real) media / mulheres);\ul\par
\ulnone           \ul escreva\ulnone ("O n\'famero de homens \'e9 ", homens);\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
4 -\cf1\f2  \f0 Escreva um programa para calcular e mostrar o reajuste salarial de uma empresa que possui 1000 funcion\'e1rios, de acordo com os seguintes crit\'e9rios:\f2  \par

\pard\sa9\sl276\slmult1\f3\'fc \f0 os funcion\'e1rios com sal\'e1rio inferior a 10.000,00 devem ter um reajuste de 55%;\f2\par
\f3\'fc \f0 os funcion\'e1rios com sal\'e1rio entre 10.000,00 (inclusive) e 25.000,00 (inclusive) devem ter um reajuste de 30%;\par

\pard\sa200\sl276\slmult1\f3\'fc \f0 e os funcion\'e1rios com sal\'e1rio superior a 25.000,00 devem ter um reajuste de 20%.\cf0\par
\ul algoritmo\ulnone  REAJUSTE\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  ciclo, funcionario;\par
          \ul real:\ulnone  salario;\par
          \ul para\ulnone  ciclo \ul de\ulnone  0 \ul at\'e9\ulnone  1000 \ul passo\ulnone  1 \ul fa\'e7a\ulnone\par
               \ul escreva\ulnone ("Informe o c\'f3digo do funcion\'e1rio");\par
               \ul leia\ulnone (funcionario);\par
               \ul escreva\ulnone (" Informe o sal\'e1rio do funcion\'e1rio");\par
               \ul leia\ulnone (salario);\par
               \ul se\ulnone  (salario > 0 E salario < 10000) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone ("O novo sal\'e1rio do funcion\'e1rio ", funcionario, " \'e9 ", salario * 1,55);\par
               \ul sen\'e3o se\ulnone  (salario >= 10000 E salario <= 25000) \ul ent\'e3o\ulnone\par
                    \ul escreva\ulnone ("O novo sal\'e1rio do funcion\'e1rio ", funcionario, " \'e9 ", salario * 1,30);\par
               \ul sen\'e3o se\ulnone  (salario > 25000) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone ("O novo sal\'e1rio do funcion\'e1rio ", funcionario, " \'e9 ", salario * 1,20);\par
               \ul sen\'e3o\ulnone\par
                    \ul escreva\ulnone ("Sal\'e1rio inv\'e1lido!");\par
               \ul fim-se;\ulnone\par
          \ul fim-para;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
5 - \cf1 Fa\'e7a um programa que receba a idade, a altura de 15 pessoas. Calcule e escreva: \par

\pard\fi568\sa9\sl276\slmult1\f3\'fc \f0 a quantidade de pessoas com idade superior a 50 anos;\f2\par
\f3\'fc \f0 a m\'e9dia das alturas das pessoas com idade entre 10 e 20 anos;\f2\par

\pard\fi568\sa200\sl276\slmult1\f3\'fc \f0 a maior altura encontrada;\cf0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  IDADE\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  idade, idoso \f1\u8592?\f0\lang22  0, jovem \f1\u8592?\f0\lang22  0, pessoas;\ul\par
\ulnone           \ul real:\ulnone  altura, media \f1\u8592?\f0\lang22  0, maiorA \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul para\ulnone  ciclo \ul de\ulnone  0 \ul at\'e9\ulnone  15 \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\par
\ulnone                     \ul escreva\ulnone ("Informe a sua idade");\ul\par
\ulnone                     \ul leia\ulnone (idade);\ul\par
\ulnone                     \ul escreva\ulnone ("Informe a sua altura");\ul\par
\ulnone                     \ul leia\ulnone (altura);\ul\par
\ulnone                     \ul se\ulnone  (idade > 50) \ul ent\'e3o\par
\ulnone                          idoso++;\par
                    \ul sen\'e3o se\ulnone  (idade >= 10 E idade <= 20) \ul ent\'e3o\par
\ulnone                          jovem++;\par
                         media \f1\u8592?\f0\lang22  media + altura;\par
                    \ul fim-se;\par
\ulnone                     \ul se\ulnone  (altura > maiorA) \ul ent\'e3o\par
\ulnone                          maiorA \f1\u8592?\f0\lang22  altura;\ul\par
\ulnone                     \ul fim-se;\par
\ulnone                \ul fim-para;\par
\ulnone           \ul escreva\ulnone ("A quantidade de pessoas com idade superior a 50 anos \'e9 ", idoso);\par
          \ul escreva\ulnone ("A m\'e9dia das alturas das pessoas com idade entre 10 e 20 anos \'e9 ", (real) media / jovem);\par
          \ul escreva\ulnone ("A maior altura encontrada \'e9 ", maiorA);\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par

\pard\sl276\slmult1 6 -\cf1\f2  \f0 Fa\'e7a um programa que leia o nome, sexo, peso, altura e idade dos 50 funcion\'e1rios de uma empresa. \par

\pard\fi568\sl276\slmult1 Apresente: \par
- IMC (\'cdndice de Massa Corporal) de cada funcion\'e1rio; (IMC = peso / altura * altura) \par
- Percentual de funcion\'e1rios obesos (IMC >= 30); \par

\pard\fi568\sa200\sl276\slmult1 - Percentual de funcion\'e1rios com peso normal (IMC <= 25 para homens e IMC <= 27 para mulheres);\f2\fs23  \cf0\f0\fs24\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  IMC\par
     \ul inicio\par
\ulnone           \ul caractere:\ulnone  nomeFuncionario[20], sexo;\ul\par
\ulnone           \ul inteiro:\ulnone  ciclo, idade, normal \f1\u8592?\f0\lang22  0, obeso \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul real:\ulnone  altura, peso, IMC;\ul\par
\ulnone           \ul para\ulnone  ciclo \ul de\ulnone  0 \ul at\'e9\ulnone  50 \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\par
\ulnone                     \ul escreva\ulnone ("Informe o seu nome");\ul\par
\ulnone                     \ul leia\ulnone (nomeFuncionario);\ul\par
\ulnone                     \ul escreva\ulnone ("Informe o seu sexo");\ul\par
\ulnone                     \ul leia\ulnone (sexo);\ul\par
\ulnone                     \ul escreva\ulnone ("Informe o seu peso");\ul\par
\ulnone                     \ul leia\ulnone (peso);\ul\par
\ulnone                     \ul escreva\ulnone ("Informe a sua altura");\ul\par
\ulnone                     \ul leia\ulnone (altura);\ul\par
\ulnone                     \ul escreva\ulnone ("Informe a sua idade");\ul\par
\ulnone                     \ul leia\ulnone (idade);\ul\par
\ulnone                     IMC \f1\u8592?\f0\lang22  (real) peso / (altura * altura);\ul\par
\ulnone                     \ul escreva\ulnone (" A(O) funcion\'e1ria(o) ", nomeFuncionario, " tem IMC ", IMC);\ul\par
\ulnone                     \ul se\ulnone  (IMC >= 30) \ul ent\'e3o\ulnone\par
                         obeso++;\ul\par
\ulnone                     \ul sen\'e3o se\ulnone  ((IMC <= 25 E sexo = 'M') OU (IMC <= 27 E sexo = 'F')) \ul ent\'e3o\par
\ulnone                          normal++;\ul\par
\ulnone                     \ul fim-se;\ulnone\par
               \ul fim-para;\par
\ulnone           \ul escreva\ulnone ("Obesos: ", obeso, "; Peso normal: ", normal);\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
7 - \cf1 Uma empresa fez uma pesquisa com 100 de seus funcion\'e1rios, coletando dados sobre o sal\'e1rio e n\'famero de filhos. A empresa deseja saber: a m\'e9dia salarial destes funcion\'e1rios; a m\'e9dia do n\'famero de filhos; e o percentual de pessoas com sal\'e1rio de at\'e9 R$ 300,00, que possuem filhos. \cf0\par
\ul algoritmo\ulnone  SALARIO\par
     \ul in\'edcio\par
\ulnone           \ul inteiro:\ulnone  ciclo, numFilhos, totalFilhos \f1\u8592?\f0\lang22  0, filhoESalarioP \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul real:\ulnone  salario, totalSalario \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul para\ulnone  ciclo \ul de\ulnone  0 \ul at\'e9\ulnone  100 \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\ulnone\par
                    \ul escreva\ulnone ("Informe o sal\'e1rio do funcion\'e1rio");\par
                    \ul leia\ulnone (salario);\par
                    \ul escreva\ulnone ("Informe o n\'famero de filhos");\par
                    \ul leia\ulnone (numFilhos);\par
                    totalSalario \f1\u8592?\f0\lang22  totalSalario + salario;\par
                    totalFilhos \f1\u8592?\f0\lang22  totalFilhos + numFilhos;\par
                    \ul se\ulnone  (salario <= 300 E numFilhos > 0) \ul ent\'e3o\ulnone\par
                         filhoESalarioP++;\par
                    \ul fim-se;\ulnone\par
               \ul fim-para;\ulnone\par
          \ul escreva\ulnone ("A m\'e9dia sal\'e1rial destes funcion\'e1rios \'e9 ", (real) totalSalario / 100);\par
          \ul escreva\ulnone (" A m\'e9dia do n\'famero de filhos \'e9 ", (real) totalFilhos / 100);\par
          \ul escreva\ulnone (" O percentual de pessoas com sal\'e1rio de at\'e9 R$ 300,00, que possuem filhos \'e9 ", filhoESalarioP, "%");\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
8 - \cf1 Fazer um algoritmo para determinar e escrever o valor do seguinte somat\'f3rio:\par

\pard\sa200\sl276\slmult1\qc\b S = X \endash  X2/3! + X4/5! \endash  X6/7! + X8/!9 - ...\b0\par

\pard\fi284\sa200\sl276\slmult1 Usando os \i n \i0 primeiros termos do somat\'f3rio. O valor de X e de \i n \i0\'e9 fornecido pelo usu\'e1rio.\cf0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  SOMATORIO\par
     \ul fun\'e7\'e3o\ulnone  expoente(\ul inteiro:\ulnone  num) \ul inteiro\par
\ulnone           \ul inicio\par
\ulnone                \ul inteiro:\ulnone  res;\ul\par
\ulnone                \ul se\ulnone  (num = 0) \ul ent\'e3o\par
\ulnone                     retorna 1;\par
               \ul sen\'e3o\par
\ulnone                     res \f1\u8592?\f0\lang22  num * 2;\par
               \ul fim-se;\ulnone\par
               \ul retorna\ulnone  res;\par
          \ul fim;\par
\ulnone      \ul fim-fun\'e7\'e3o.\par
\ulnone      \ul fun\'e7\'e3o\ulnone  fatorial(\ul inteiro:\ulnone  num) \ul inteiro\par
\ulnone           \ul inicio\par
\ulnone                \ul inteiro:\ulnone  res;\par
               res \f1\u8592?\f0\lang22  num;\ul\par
\ulnone                \ul enquanto\ulnone  (num >= 2) \ul fa\'e7a\par
\ulnone                     res \f1\u8592?\f0\lang22  res * --num;\par
               \ul fim-enquanto;\ulnone\par
               \ul retorna\ulnone  res;\par
          \ul fim;\par
\ulnone      \ul fim-fun\'e7\'e3o.\par
\ulnone\{programa-principal\}\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  ciclo \f1\u8592?\f0\lang22  1, valorX, valorN, numFatorial \f1\u8592?\f0\lang22  1, exp \f1\u8592?\f0\lang22  0, num1, num2;\ul\par
\ulnone           \ul real:\ulnone  valorS \f1\u8592?\f0\lang22  0;\ul\par
\ulnone           \ul escreva\ulnone ("Informe o valor de X");\ul\par
\ulnone           \ul leia\ulnone (valorX);\ul\par
\ulnone           \ul escreva\ulnone ("Informe o valor de n");\ul\par
\ulnone           \ul leia\ulnone (valorN);\ul\par
\ulnone           \ul para\ulnone  ciclo \ul de\ulnone  1 \ul at\'e9\ulnone  ciclo <= valorN \ul passo\ulnone  1 \ul fa\'e7a\par
\ulnone                \ul in\'edcio\ulnone\par
                    num1 \f1\u8592?\f0\lang22  fatorial(numFatorial);\par
                    num2 \f1\u8592?\f0\lang22  expoente(exp);\par
                    \ul se\ulnone  (ciclo MOD 2 = 1) \ul ent\'e3o\ulnone\par
                         valorS \f1\u8592?\f0\lang22  valorS + (pow(valorX, num2) / num1);\par
                    \ul sen\'e3o\ulnone\par
                         valorS \f1\u8592?\f0\lang22  valorS - (pow(valorX, num2) / num1);\par
                    numFatorial \f1\u8592?\f0\lang22  numFatorial + 2;\par
                    exp++;\par
               \ul fim;\ulnone\par
          \ul fim-para;\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par

