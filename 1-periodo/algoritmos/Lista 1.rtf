          \ul escreva\ulnone ("Insira tr\'eas valores");\par
          \ul leia\ulnone (vA, vB, vC);\par
          vD \f1\u8592?\f0\lang1046  vA;\par
\lang22           vA \f1\u8592?\f0\lang1046  vB;\par
