5 - Criar um programa para ler o pre\'e7o e a categoria de um produto. Calcular o reajuste de acordo com a categoria: se a mesma for A=50%, B=25%, C=15% e outras 5%. Depois mostre o valor antigo, o percentual de reajute e o valor reajustado.\par
\ul algoritmo\ulnone  REAJUSTE_PRECO\ul\par
\ulnone      \ul inicio\par
\ulnone           \ul caractere:\ulnone  categoria;\par
          \ul real:\ulnone  preco; \par
          \ul escreva\ulnone ("Informe o pre\'e7o e a categoria do produto");\par
          \ul leia\ulnone (preco, categoria);\par
          \ul escolha\ulnone (categoria)\par
          \ul inicio\ulnone\par
               \ul caso\ulnone  'A' : \ul escreva\ulnone ("O valor antigo era R$:", preco, "; o reajuste ser\'e1 de 50%, deixando o pre\'e7o R$:", preco*0,5);\par
               \ul caso\ulnone  'B' : \ul escreva\ulnone ("O valor antigo era R$:", preco, "; o reajuste ser\'e1 de 25%, deixando o pre\'e7o R$:", preco*0,25);\par
               \ul caso\ulnone  'C' : \ul escreva\ulnone ("O valor antigo era R$:", preco, "; o reajuste ser\'e1 de 15%, deixando o pre\'e7o R$:", preco*0,15);\par
               \ul caso\ulnone  'D' : \ul escreva\ulnone ("O valor antigo era R$:", preco, "; o reajuste ser\'e1 de 5%, deixando o pre\'e7o R$:", preco*0,05);\par
               \ul caso-contr\'e1rio:\ulnone  \ul escreva\ulnone ("Categoria desconhecida!");\par
          \ul fim-escolha;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par

\pard\sl276\slmult1 6 - Perguntar ao usu\'e1rio se ele deseja calcular:\par
1) a \'e1rea de um tri\'e2ngulo;\par
2) a \'e1rea de um circulo;\par
3) a \'e1rea de um cubo;\par
4) a \'e1rea de um cilindro.\par

\pard\sa200\sl276\slmult1      Solicitar os dados necess\'e1rios para calcular a \'e1rea escolhida, e mostrar o resultado na tela.\par
\ul algoritmo\ulnone  CALCULA_AREA\ul\par
\ulnone      \ul inicio\par
\ulnone           \ul caractere:\ulnone  forma;\par
          \ul real:\ulnone  medida1, medida2;\par
          \ul escreva\ulnone ("Informe a forma geom\'e9trica desejada");\par
          \ul escreva\ulnone ("Cilindro - C");\par
          \ul escreva\ulnone ("C\'edrculo - R");\par
          \ul escreva\ulnone ("Cubo - U");\par
          \ul escreva\ulnone ("Tri\'e2ngulo - T");\par
          \ul leia\ulnone (forma);\par
          \ul escolha\ulnone (forma)\par
          \ul inicio\ulnone\par
               \ul caso\ulnone  'C' : \ul escreva\ulnone ("Informe a altura e o raio do cilindro");\par
                               \ul leia\ulnone (medida1, medida2);\par
                               \ul escreva\ulnone ("A \'e1rea do cilindro \'e9 ", 2 * 3,14 * medida2 * (medida2 + medida1));\par
               \ul caso\ulnone  'R' : \ul escreva\ulnone ("Informe o raio do c\'edrculo");\par
                               \ul leia\ulnone (medida1);\par
                               \ul escreva\ulnone ("A \'e1rea do c\'edrculo \'e9 ", 3,14 * pow(medida1,2));\par
               \ul caso\ulnone  'U' : \ul escreva\ulnone ("Informe a medida do lado do cubo");\par
                               \ul leia\ulnone (medida1);\par
                               \ul escreva\ulnone ("A \'e1rea do cubo \'e9 ", 6 * pow(medida,2));\par
               \ul caso\ulnone  'T' : \ul escreva\ulnone ("Informe a altura e a base do tri\'e2ngulo");\par
                               \ul leia\ulnone (medida1, medida2);\par
                               \ul escreva\ulnone ("A \'e1rea do tri\'e2ngulo \'e9 ", (medida2*medida1)/2);\par
               \ul caso-contr\'e1rio:\ulnone  \ul escreva\ulnone ("Forma geom\'e9trica desconhecida!");\par
          \ul fim-escolha;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
7 - Elabore um algoritmo que, apresente um menu, com as seguintes op\'e7\'f5es : Calcular a m\'e9dia aritm\'e9tica, Calcular a m\'e9dia harm\'f4nica e Calcular a m\'e9dia geom\'e9trica. E conforme a op\'e7\'e3o do usu\'e1rio realize a opera\'e7\'e3o selecionada.\par
\ul algoritmo\ulnone  MEDIAS\ul\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  conta;\ul\par
\ulnone           \ul real:\ulnone  valor1, valor2, valor3;\par
          \ul escreva\ulnone ("Apenas calcula tr\'eas valores");\par
          \ul escreva\ulnone ("1. Calcular a m\'e9dia aritm\'e9tica");\par
          \ul escreva\ulnone ("2. Calcular a m\'e9dia harm\'f4nica");\par
          \ul escreva\ulnone ("3. Calcular a m\'e9dia geom\'e9trica");\par
          \ul leia\ulnone (valor1, valor2, valor3);\par
          \ul escolha\ulnone (conta)\par
          \ul inicio\ulnone\par
               \ul caso\ulnone  1 : \ul escreva\ulnone ("A m\'e9dia aritm\'e9tica \'e9 ", (valor1 + valor2 + valor3)/3);\par
               \ul caso\ulnone  2 : \ul escreva\ulnone ("A m\'e9dia harm\'f4nica \'e9 ", (valor1 * valor2 * valor3)**(1/3));\par
               \ul caso\ulnone  3 : \ul escreva\ulnone ("A m\'e9dia geom\'e9trica \'e9 ", 3/(1/valor1 + 1/valor2 + 1/valor3));\par
               \ul caso-contr\'e1rio:\ulnone  \ul escreva\ulnone ("C\'e1lculo desconhecido!");\par
          \ul fim-escolha;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
8 - Construa um programa que, tendo como dados de entrada o pre\'e7o de um produto e um c\'f3digo de origem, mostre o pre\'e7o junto de sua proced\'eancia (Ex.: 500.00 \f1\endash  Sul). Caso o c\f0\'f3digo n\'e3o seja nenhum dos especificados, o produto deve ser encarado como importado.\par
C\'f3digo de origem:\par

\pard\sl276\slmult1 1 \f1\endash  Sul \par
2 \endash  Norte \par
3 \endash  Leste \par
4 \endash  Oeste \par
5 ou 6 \endash  Nordeste\par
7 ou 8 ou 9 \endash  Sudeste\par
10 at\f0\'e9 20 \f1\endash  Centro Oeste\par

\pard\sa200\sl276\slmult1 25 at\f0\'e9 50 \f1\endash  Nordeste\f0\par
\ul algoritmo\ulnone  REGIAO\ul\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  codigo;\par
          \ul real:\ulnone  preco;\par
          \ul escreva\ulnone ("Informe o c\'f3digo e o pre\'e7o do produto");\par
          \ul leia\ulnone (codigo, preco);\par
          \ul escolha\ulnone (codigo)\par
          \ul inicio\ulnone\par
               \ul caso\ulnone  1 : \ul escreva\ulnone (preco, " - Sul");\par
               \ul caso\ulnone  2 : \ul escreva\ulnone (preco, " - \f1 Norte\f0 ");\par
               \ul caso\ulnone  3 : \ul escreva\ulnone (preco, " - \f1 Leste\f0 ");\par
               \ul caso\ulnone  4 : \ul escreva\ulnone (preco, " - \f1 Oeste\f0 ");\par
               \ul caso\ulnone  5, 6, 25..50 : \ul escreva\ulnone (preco, " - \f1 Nordeste\f0 ");\par
               \ul caso\ulnone  7, 8, 9 : \ul escreva\ulnone (preco, " - \f1 Sudeste\f0 ");\par
               \ul caso\ulnone  10..20 : \ul escreva\ulnone (preco, " - \f1 Centro Oeste\f0 ");\par
               \ul caso-contr\'e1rio:\ulnone  \ul escreva\ulnone (preco, " - Importado");\par
          \ul fim-escolha;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
9 - Desenvolva um programa para fazer a convers\'e3o de Real para Dollar e vice e versa. Para isso o usu\'e1rio dever\'e1 informar o valor em uma moeda a cota\'e7\'e3o e fazer a sua convers\'e3o. Apresente o valor convertido. \par
\ul algoritmo\ulnone  CONVERSOR_MOEDAS\ul\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  moeda;\par
          \ul real:\ulnone  valor, cotacao;\par
          \ul escreva\ulnone ("Escolha a moeda desejada:");\par
          \ul escreva\ulnone ("1. D\'f3llar");\par
          \ul escreva\ulnone ("2. Real");\par
          \ul leia\ulnone (moeda);\par
          \ul escolha\ulnone (moeda)\par
          \ul inicio\ulnone\par
               \ul caso\ulnone  1 : \ul escreva\ulnone ("Informe o valor em real que voc\'ea deseja converter em d\'f3llar");\par
                            \ul leia\ulnone (valor);\par
                            \ul escreva\ulnone ("Informe a cota\'e7\'e3o atual do d\'f3llar");\par
                            \ul leia\ulnone (cotacao);\par
                            \ul escreva\ulnone ("U$: ", valor*cotacao);\par
               \ul caso\ulnone  2 : \ul escreva\ulnone ("Informe o valor em d\'f3llar que voc\'ea deseja converter em real");\par
                            \ul leia\ulnone (valor);\par
                            \ul escreva\ulnone ("Informe a cota\'e7\'e3o atual do real");\par
                            \ul leia\ulnone (cotacao);\par
                            \ul escreva\ulnone ("R$: ", valor*cotacao);\par
               \ul caso-contr\'e1rio:\ulnone  \ul escreva\ulnone ("Moeda desconhecida!");;\par
          \ul fim-escolha;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
