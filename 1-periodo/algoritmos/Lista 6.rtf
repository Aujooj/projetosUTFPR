\pard\sa200\sl276\slmult1\f0\fs24\lang22 1 - Escrever um programa que l\'ea 5 conjuntos de 2 valores, o primeiro representando o n\'famero de um aluno e o segundo representando a sua altura em cent\'edmetros. Encontrar o aluno mais alto e o mais baixo e escrever seus n\'fameros, suas alturas e uma mensagem dizendo se \'e9 o mais alto ou o mais baixo.\par
\ul algoritmo\ulnone  ESCOLHE_ALTURA\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  numAluno1, numAluno2, altura1, altura2 \f1\u8592?\f0\lang22  0, altura3 \f1\u8592?\f0\lang22  300, ciclo \f1\u8592?\f0\lang22  0, baixo, alto;\par
          \ul repita\ulnone\par
               \ul escreva\ulnone (" Insira o n\'famero do aluno");\par
               \ul leia\ulnone (numAluno1);\par
               \ul escreva\ulnone (" Insira a altura do aluno, em cent\'edmetros");\par
               \ul leia\ulnone (altura1);\par
               \ul se\ulnone  (altura1 > altura2) \ul ent\'e3o\ulnone\par
                    altura2 \f1\u8592?\f0\lang22  altura1;\par
                    alto \f1\u8592?\f0\lang22  ciclo;\par
               \ul fim-se;\par
\ulnone                \ul se\ulnone  (altura1 < altura3) \ul ent\'e3o\ulnone\par
                    altura3 \f1\u8592?\f0\lang22  altura1;\par
                    baixo \f1\u8592?\f0\lang22  ciclo;\par
               \ul fim-se;\par
\ulnone                ciclo++;\ul\par
\ulnone                \ul se\ulnone  (ciclo = 5) \ul ent\'e3o\ulnone\par
                    \ul escreva\ulnone ("O aluno mais alto \'e9 o ", alto," e ele tem ", (real) altura2/100," metros de altura");\par
                    \ul escreva\ulnone (" O aluno mais baixo \'e9 o ", baixo," e ele tem ", (real) altura3/100," metros de altura");\par
               \ul fim-se;\par
\ulnone           \ul at\'e9\ulnone  (ciclo = 5);\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
