\pard\sl276\slmult1\f0\fs24\lang22 12 - \cf1 Escrever um programa que l\'ea um conjunto de 4 valores i, a, b, c, onde i \'e9 um valor inteiro e positivo e a, b, c, s\'e3o quaisquer valores reais e os escreva. A seguir: \par
1. Se i = 1 escrever os tr\'eas valores a, b, c em ordem crescente. \par
2. Se i = 2 escrever os tr\'eas valores a, b, c em ordem decrescente. \par

\pard\sa200\sl276\slmult1 3. Se i = 3 escrever os tr\'eas valores a, b, c de forma que o maior entre a, b, c fique dentre os dois\cf0 .\par
\ul algoritmo\ulnone  ORGANIZA_NUMERO\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  valorI;\par
          \ul real:\ulnone  valorA, valorB, valorC;\par
          \ul escreva\ulnone ("Escolha um valor entre 1, 2 e 3, e escreva-o; e insira outros tr\'eas valores reais");\par
          \ul leia\ulnone (valorI, valorA, valorB, valorC);\par
          \ul se\ulnone  (i = 1) \ul ent\'e3o\par
\ulnone                \ul se\ulnone  (valor A > valorB E valorA > valorC) \ul ent\'e3o\par
\ulnone                     \ul se\ulnone  (valorB  > valorC) \ul ent\'e3o\par
\ulnone                          \ul escreva\ulnone (valorA, valorB, valorC);\ul\par
\ulnone                     \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone (valorA, valorC, valorB);\ul\par
\ulnone                \ul sen\'e3o se\ulnone  (valor B > valorA E valorB > valorC) \ul ent\'e3o\par
\ulnone                     \ul se\ulnone  (valorA  > valorC) \ul ent\'e3o\par
\ulnone                          \ul escreva\ulnone (valorB, valorA, valorC);\ul\par
\ulnone                     \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone (valorB, valorC, valorA);\ul\par
\ulnone                \ul sen\'e3o\par
\ulnone                     \ul se\ulnone  (valorA  > valorB) \ul ent\'e3o\par
\ulnone                          \ul escreva\ulnone (valorC, valorA, valorB);\ul\par
\ulnone                     \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone (valorC, valorB, valorA);\par
               \ul fim-se;\ulnone\par
          \ul sen\'e3o se\ulnone  (i = 2) \ul ent\'e3o\par
\ulnone                 \ul se\ulnone  (valor A < valorB E valorA < valorC) \ul ent\'e3o\par
\ulnone                     \ul se\ulnone  (valorB  < valorC) \ul ent\'e3o\par
\ulnone                          \ul escreva\ulnone (valorA, valorB, valorC);\ul\par
\ulnone                     \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone (valorA, valorC, valorB);\ul\par
\ulnone                \ul sen\'e3o se\ulnone  (valor B < valorA E valorB < valorC) \ul ent\'e3o\par
\ulnone                     \ul se\ulnone  (valorA  < valorC) \ul ent\'e3o\par
\ulnone                          \ul escreva\ulnone (valorB, valorA, valorC);\ul\par
\ulnone                     \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone (valorB, valorC, valorA);\ul\par
\ulnone                \ul sen\'e3o\par
\ulnone                     \ul se\ulnone  (valorA  < valorB) \ul ent\'e3o\par
\ulnone                          \ul escreva\ulnone (valorC, valorA, valorB);\ul\par
\ulnone                     \ul sen\'e3o\par
\ulnone                          \ul escreva\ulnone (valorC, valorB, valorA);\par
               \ul fim-se;\ulnone\par
          \ul sen\'e3o\par
\ulnone                \ul se\ulnone  (valorA < valorB E valorA < valorC) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone (valorB, valor A, valorC);\ul\par
\ulnone                \ul sen\'e3o se\ulnone  (valorB < valorA E valorB < valorC) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone (valorA, valor B, valorC);\ul\par
\ulnone                \ul sen\'e3o\par
\ulnone                     \ul escreva\ulnone (valorA, valor C, valorB);\par
               \ul fim-se;\ulnone\par
          \ul fim-se;\par
\ulnone      \ul fim;\par
fim-algoritmo.\par
