\ulnone 15 - \cf1 Escreva um programa para ler as coordenadas (X,Y) de um ponto no sistema cartesiano e escrever o quadrante ao qual o ponto pertence. Caso o ponto n\'e3o perten\'e7a a nenhum quadrante, escrever se ele esta' sobre o eixo X, eixo Y ou na origem\cf0 .\par
\ul algoritmo\ulnone  QUADRANTES\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  valorX, valorY;\par
          \ul escreva\ulnone ("Informe os valores de X e Y");\par
          \ul leia\ulnone (valorX, valorY);\par
          \ul se\ulnone  (valorX = 0 E valorY = 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O ponto est\'e1 na origem");\ul\par
\ulnone           \ul sen\'e3o se\ulnone  (valorX <> 0 E valorY = 0) \ul ent\'e3o\par
\ulnone               \ul escreva\ulnone ("O ponto est\'e1 no eixo das abscissas"); \ul\par
\ulnone           \ul sen\'e3o se\ulnone  (valorX = 0 E valorY <> 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O ponto est\'e1 no eixo das ordenadas");\ul\par
\ulnone           \ul sen\'e3o se\ulnone  (valorX > 0 E valor Y > 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O ponto est\'e1 no 1\'b0 Quadrante");\ul\par
\ulnone           \ul sen\'e3o se\ulnone  (valorX < 0 E valor Y > 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O ponto est\'e1 no 2\'b0 Quadrante");\ul\par
\ulnone           \ul sen\'e3o se\ulnone  (valorX < 0 E valor Y < 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O ponto est\'e1 no 3\'b0 Quadrante");\ul\par
\ulnone           \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("O ponto est\'e1 no 4\'b0 Quadrante");\ul\par
\ulnone           \ul fim-se;\par
\ulnone      \ul fim;\par
fim-algoritmo.\par
