\ulnone 13 - \cf1 Fa\'e7a um programa que leia duas notas obtidas por um aluno na disciplina de C\'e1lculo, o n\'famero de aulas ministradas e o n\'famero de aulas assistidas por este aluno nesta disciplina. Calcule e mostre a m\'e9dia final deste aluno e diga se ele foi aprovado ou reprovado. Considere que para um aluno ser aprovado ele deve obter m\'e9dia final igual ou maior a 6 e ter no m\'ednimo 75% de frequ\'eancia\cf0 .\par
\ul algoritmo\ulnone  CALCULO\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  num_aulas, num_vistas;\par
          \ul real:\ulnone  nota1, nota2;\par
          \ul escreva\ulnone ("Insira as suas duas notas, o n\'famero de aulas ministradas, e quantas o aluno assistiu");\par
          \ul leia\ulnone (nota1, nota2, num_aulas, num,vistas);\par
          \ul escreva\ulnone ("A m\'e9dia final deste aluno \'e9 ", (nota1 + nota2)/2), " e ele est\'e1 ";\par
          \ul se\ulnone  ((nota1 + nota2)/2 >= 6 E num_vistas/num_aulas >= 0,75) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("Aprovado");\par
          \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("Reprovado");\par
          \ul fim-se;\ulnone\par
     \ul fim;\par
fim-algoritmo.\par
