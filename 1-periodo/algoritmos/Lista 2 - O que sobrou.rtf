\ulnone 18 - \cf2 Leia a hora inicial e a hora final de um jogo. A seguir calcule a dura\'e7\'e3o do jogo, sabendo que o mesmo pode come\'e7ar em um dia e terminar em outro, tendo uma dura\'e7\'e3o m\'e1xima de 24 horas.\cf0\par
\ul algoritmo\ulnone  TEMPO_JOGO\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  hora1, hora2, minutos1, minutos2, conta1, conta2;\par
          \ul escreva\ulnone ("Informe o hor\'e1rio dos dois jogos");\par
          \ul leia\ulnone (hora1, minutos1, hora2, minutos2);\par
          conta1 \f1\u8592?\f0\lang1046  hora2 - hora1;\par
\lang22           conta2 \f1\u8592?\f0\lang1046  minutos2 - minutos1;\lang22\par
          \ul se\ulnone  (conta1 > 0) \ul ent\'e3o\par
\ulnone                \ul se\ulnone  (conta2 > 0) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone ("O jogo teve dura\'e7\'e3o de ", conta1, ":", conta2, " horas");\par
               \ul sen\'e3o\par
\ulnone                     \ul escreva\ulnone ("O jogo teve dura\'e7\'e3o de ", conta1, ":", conta2 + 60, " horas");\par
               \ul fim-se;\ulnone\par
          \ul sen\'e3o se\ulnone  (conta1 < 0) \ul ent\'e3o\par
\ulnone                \ul se\ulnone  (conta2 > 0) \ul ent\'e3o\par
