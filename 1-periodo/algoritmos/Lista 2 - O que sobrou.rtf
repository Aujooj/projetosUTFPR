\ulnone 16 - \cf1 Dados tr\'eas valores X, Y e Z, verificar se eles podem ser os comprimentos dos lados de um tri\'e2ngulo e, se forem, verificar se \'e9 um tri\'e2ngulo equil\'e1tero, is\'f3sceles ou escaleno. Se eles n\'e3o formarem um tri\'e2ngulo, escreva uma mensagem\cf0 .\par
\ul algoritmo\ulnone  TRIANGULO\par
     \ul inicio\par
\ulnone           \ul inteiro:\ulnone  valorX, valorY, valorZ;\par
          \ul escreva\ulnone ("Insira os valores dos 3 lados do tri\'e2ngulo");\par
          \ul leia\ulnone (valorX, valorY, valorZ);\par
          \ul se\ulnone  (valorX+valorY>valorZ E valorX+valorZ>valorY E valorY+valorZ>valorX) \ul ent\'e3o\par
\ulnone                \ul se\ulnone  (valorX = valorY E valorY = valorZ) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone ("Esse tri\'e2ngulo \'e9 equil\'e1tero");\par
               \ul sen\'e3o\ulnone  (valorX <> valorY E valorY <> valorZ) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone ("Esse tri\'e2ngulo \'e9 escaleno");\ul\par
\ulnone                \ul sen\'e3o\par
\ulnone                     \ul escreva\ulnone ("Esse tri\'e2ngulo \'e9 is\'f3sceles");\ul\par
\ulnone                \ul fim-se;\ulnone\par
          \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("Os valores informados n\'e3o formam um tri\'e2ngulo");\ul\par
\ulnone           \ul fim-se;\ulnone\par
     \ul fim;\par
fim-algoritmo.\par
