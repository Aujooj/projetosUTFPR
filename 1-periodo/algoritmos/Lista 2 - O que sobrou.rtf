\ulnone 14 - \cf1 O departamento que controla o \'edndice de polui\'e7\'e3o do meio ambiente mant\'e9m 3 grupos de ind\'fastrias que s\'e3o altamente poluentes do meio ambiente. O \'edndice de polui\'e7\'e3o aceit\'e1vel varia de 0,05 at\'e9 0,25. Se o \'edndice sobe para 0,3 as ind\'fastrias do 1\'b0 grupo s\'e3o intimadas a suspenderem suas atividades, se o \'edndice cresce para 0,4 as do 1\'b0 e 2\'b0 grupo s\'e3o intimadas a suspenderem suas atividades e se o \'edndice atingir 0,5 todos os 3 grupos devem ser notificados a paralisarem suas atividades. Escrever um programa que l\'ea o \'edndice de polui\'e7\'e3o medido e emite a notifica\'e7\'e3o adequada aos diferentes grupos de empresas\cf0  .\par
\ul algoritmo\ulnone  POLUICAO\par
     \ul inicio\par
\ulnone           \ul real:\ulnone  indice_poluicao;\par
          \ul escreva\ulnone ("Informe o indice de polui\'e7\'e3o");\par
          \ul leia\ulnone (indice_poluicao);\par
          \ul se\ulnone  (indice_poluicao < 0,05) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O indice de polui\'e7\'e3o est\'e1 bom");\par
          \ul sen\'e3o se\ulnone  (indice_poluicao < 0,3) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("O indice de polui\'e7\'e3o est\'e1 aceit\'e1vel");\par
          \ul sen\'e3o se\ulnone  (indice_poluicao < 0,4) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("\cf1 As ind\'fastrias do 1\'b0 grupo devem ser intimadas a suspenderem suas atividades\cf0 ");\par
          \ul sen\'e3o se\ulnone  (indice_poluicao < 0,5) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("\cf1 As ind\'fastrias do 1\'b0 e 2\'b0 grupo devem ser intimadas a suspenderem suas atividades\cf0 ");\par
          \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("Todas a\cf1 s ind\'fastrias devem ser intimadas a suspenderem suas atividades\cf0 ");\par
          \ul fim-se;\ulnone\par
     \ul fim;\par
fim-algoritmo.\par
