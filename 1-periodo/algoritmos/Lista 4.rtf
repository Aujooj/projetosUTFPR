\pard\sa200\sl276\slmult1\f0\fs24\lang22 1 - \cf1 Cada degrau de uma escada tem X de altura. Fa\'e7a um programa que receba esta altura em cent\'edmetros e a altura em metros que o usu\'e1rio deseja alcan\'e7ar subindo a escada, calcule e mostre quantos degraus ele dever\'e1 subir para atingir seu objetivo, sem se preocupar com a altura do usu\'e1rio.\f1\fs23  \cf0\f0\fs24\par
\ul algoritmo\ulnone  CALCULA_ESCADA\par
     \ul fun\'e7\'e3o\ulnone  calculaDegrau(real: hD, real: hT): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  (\lang22 hT*100)/hD;\ul\par
\ulnone                \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  valor_cm, valor_m;\par
          \ul escreva\ulnone ("Informe a altura, em cent\'edmetros, de um degrau dessa escada e depois a altura, em metros, que voc\'ea deseja atingir");\par
          \ul leia\ulnone (valor, valor_m);\par
          \ul escreva\ulnone ("Voc\'ea dever\'e1 subir ", calculaDegrau(valor_cm, valor_m), " degraus!");\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
2 - \cf1 Fa\'e7a um programa que receba do usu\'e1rio um n\'famero positivo e diferente de zero, calcule e mostre: (para cada calculo utilize procedimentos):\f1\par

\pard\fi568\sl276\slmult1\f0 1. A quadrado do n\'famero;\par
2. A raiz c\'fabica do n\'famero;\par
3. A raiz quadrada do n\'famero;\par

\pard\fi568\sa200\sl276\slmult1 4. O cubo do n\'famero.\cf0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  CALCULOS\par
     \ul procedimento\ulnone  quadradoNum(inteiro: a)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("O quadrado do n\'famero ", num, " \'e9 ", pow(a,2));\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\ulnone      \ul procedimento\ulnone  raizCubicaNum(real: b)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("A raiz c\'fabica do n\'famero ", num, " \'e9 ", pow(b ,1/3);\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\ulnone      \ul procedimento\ulnone  raizQuadradaNum(real: c)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("A raiz quadrada do n\'famero ", num, " \'e9 ", sqrt(c));\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\ulnone      \ul procedimento\ulnone  cuboNum(inteiro: d)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("O cubo do n\'famero ", num, " \'e9 ", pow(d,3));\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  num;\ul\par
\ulnone           \ul escreva\ulnone ("Informe um n\'famero positivo diferente de zero");\par
          \ul leia\ulnone ();\par
          quadradoNum(num);\par
          raizCubicaNum(num);\ul\par
\ulnone           raizQuadradaNum(num);\ul\par
\ulnone           cuboNum(num);\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
3 - \cf1 Perguntar ao usu\'e1rio se ele deseja calcular:\par

\pard\fi568\sl276\slmult1 1) a \'e1rea de um tri\'e2ngulo \par
2) a \'e1rea de um circulo \par
3) a \'e1rea de um cubo \par

\pard\fi568\sa200\sl276\slmult1 4) a \'e1rea de um cilindro \par

\pard\sa200\sl276\slmult1\cf0      \cf1 Solicitar os dados necess\'e1rios para calcular a \'e1rea escolhida, passando os dados como parametro \'e0 respectiva fun\'e7\'e3o de calculo e mostrar o resultado na tela. \cf0\par
\ul algoritmo\ulnone  CALCULA_AREAS\par
     \ul fun\'e7\'e3o\ulnone  areaTriangulo(real: altura, real: base): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  (base*altura)/2;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\ulnone      \ul fun\'e7\'e3o\ulnone  areaCirculo(real: raio): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul constante real:\ulnone  pi \f2\u8592?\f0\lang22  3,14;\ul\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pi*(pow(raio,2));\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\ulnone      \ul fun\'e7\'e3o\ulnone  areaCubo(real: aresta): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  6*(pow(aresta,2));\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\ulnone      \ul fun\'e7\'e3o\ulnone  areaCilindro(real: altura, real: raio): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul constante real:\ulnone  pi \f2\u8592?\f0\lang22  3,14;\ul\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  2*(pi*pow(raio,2)) + 2*(pi*raio*altura);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  opcao;\par
          \ul real:\ulnone  valor1, valor2;\ul\par
\ulnone           \ul escreva\ulnone ("Escolha o que deseja calcular");\par
          \ul escreva\ulnone ("\cf1 1. A \'e1rea de um tri\'e2ngulo\cf0 ");\par
          \ul escreva\ulnone ("2. A \'e1rea de um \cf1 circulo\cf0 ");\ul\par
\ulnone           \ul escreva\ulnone ("3. A \'e1rea de um cubo");\ul\par
\ulnone           \ul escreva\ulnone ("4. A \'e1rea de um \cf1 cilindro\cf0 ");\par
          \ul leia\ulnone (opcao);\par
          \ul se\ulnone  (opcao = 1) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("Informe o valor da altura, e da base do tri\'e2ngulo");\par
               \ul leia\ulnone (valor1, valor2);\ul\par
\ulnone                \ul escreva\ulnone ("A \'e1rea do tri\'e2ngulo \'e9 ", areaTriangulo(valor1, valor2));\ul\par
\ulnone           \ul sen\'e3o\ulnone  \ul se\ulnone  (opcao = 2) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("Informe o valor do raio do circulo");\par
               \ul leia\ulnone (valor1);\ul\par
\ulnone                \ul escreva\ulnone ("A \'e1rea do circulo \'e9 ", areaCirculo(valor1));\ul\par
\ulnone           \ul sen\'e3o\ulnone  \ul se\ulnone  (opcao = 3) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("Informe o valor da aresta do cubo");\par
               \ul leia\ulnone (valor1);\ul\par
\ulnone                \ul escreva\ulnone ("A \'e1rea do cubo \'e9 ", areaCubo(valor1));\ul\par
\ulnone           \ul sen\'e3o\ulnone  \ul se\ulnone  (opcao = 4) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("Informe o valor da altura, e do raio do cilindro");\par
               \ul leia\ulnone (valor1, valor2);\ul\par
\ulnone                \ul escreva\ulnone ("A \'e1rea do cilindro \'e9 ", areaCilindro(valor1, valor2));\ul\par
\ulnone           \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("Op\'e7\'e3o desconhecida!");\ul\par
\ulnone           \ul fim-se;\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
4 - \cf1 Fa\'e7a um programa em linguagem C no qual o usu\'e1rio forne\'e7a uma temperatura em grau Celsius e o mesmo converta em Fahrenheit. Caso a temperatura seja fornecida em Fahrenheit converta para grau Celsius. Utilize fun\'e7\'f5es para os c\'e1lculos.\cf0\par
\ul algoritmo\ulnone  CONVERTE_TEMPERATURA\par
     \ul fun\'e7\'e3o\ulnone  tempCelsius(inteiro: fahr): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  (\lang22 fahr\lang1046  - 32) * (5/9);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\ulnone      \ul fun\'e7\'e3o\ulnone  temp\cf1 Fahr\cf0 (inteiro: celsius): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  (celsius * (9/5)) + 32;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  opcao, temp;\ul\par
\ulnone           \ul escreva\ulnone ("Escolha a temperatura que voc\'ea quer saber:");\par
          \ul escreva\ulnone ("1. \cf1 Celsius\cf0 ");\ul\par
\ulnone           \ul escreva\ulnone ("2. \cf1 Fahrenheit\cf0 ");\par
          \ul leia\ulnone (opcao);\par
          \ul escreva\ulnone ("Informe a temperatura a ser convertida"); \par
          \ul leia\ulnone (temp);\par
          \ul se\ulnone  (opcao = 1) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("A temperatura em Celsius \'e9 ", temp\cf1 Celsius\cf0 (temp), "\'b0C");\par
          \ul sen\'e3o\ulnone  \ul se\ulnone  (opcao = 2) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("A temperatura em \cf1 Fahrenheit \cf0\'e9 ", temp\cf1 Fahr\cf0 (temp), "\'b0F");\par
          \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("Op\'e7\'e3o desconhecida!");\ul\par
\ulnone           \ul fim-se;\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
5 - \cf1 Desenvolva um programa para fazer a convers\'e3o de Real para Dol\'e1r e vice e versa. Para isso o usu\'e1rio dever\'e1 informar o valor em uma moeda a cota\'e7\'e3o e fazer a sua convers\'e3o. Apresente o valor convertido. Para realizar as convers\'f5es utilize fun\'e7\'f5es especificas.\cf0\par
\ul algoritmo\ulnone  CONVERTE_DOLAR\par
     \ul fun\'e7\'e3o\ulnone  converteMoeda(real: cotacao, real: moeda): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  cotacao * moeda;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  cotacao, moeda;\ul\par
\ulnone           \ul inteiro:\ulnone  opcao;\ul\par
\ulnone           \ul escreva\ulnone ("Escolha a moeda que voc\'ea quer saber:");\par
          \ul escreva\ulnone ("1. D\'f3lar");\ul\par
\ulnone           \ul escreva\ulnone ("2. Real");\par
          \ul leia\ulnone (opcao);\par
          \ul escreva\ulnone ("Informe a cotacao atual dessa moeda"); \par
          \ul leia\ulnone (cotacao);\par
          \ul escreva\ulnone ("Informe o valor que voc\'ea deseja converter"); \par
          \ul leia\ulnone (moeda);\par
          \ul se\ulnone  (opcao = 1) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("R$ ", moeda, "equivalem a US$ ", converteMoeda(cotacao, moeda));\par
          \ul sen\'e3o\ulnone  \ul se\ulnone  (opcao = 2) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("US$ ", moeda, "equivalem a R$ ", converteMoeda(cotacao, moeda));\par
          \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("Op\'e7\'e3o desconhecida!");\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par

\pard\sl276\slmult1 6 - \cf1 Desenvolver procedimentos que recebem como parametro o valor da moeda europeia (euro) e imprimem seu valores respectivamente em d\'f3lar e real. \par
\cf0      \cf1 As taxas de convers\'e3o dever\'e3o ser consideradas como constantes: \par

\pard\sa200\sl276\slmult1\qc\b (um euro = 2,6 reais e um d\'f3lar = 1,95 reais)\cf0\b0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  CONTERTE_MOEDAS\par
     \ul procedimento\ulnone  converteDolar(real: valorEuro)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("\'80 ", valorEuro," equivalem a US$ ", (valorEuro*2,6)/1,95);\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\ulnone      \ul procedimento\ulnone  converteReal(real: valorEuro)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("\'80 ", valorEuro," equivalem a R$ ", valorEuro*2,6);\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  valor;\par
          \ul escreva\ulnone ("Informe a valor de euros que voc\'ea deseja converter");\par
          \ul leia\ulnone (valor);\par
          converteDolar(valor);\par
          converteReal(valor);\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
7 - \cf1 Escreva um programa que leia tr\'eas n\'fameros inteiros e positivos (A, B, C) e calcule a seguinte express\'e3o:\par

\pard\sa200\sl276\slmult1\qc D=(R+S)/2. Onde : R = (A + B)\'b2 e S = (B + C)\'b2 \par

\pard\sa200\sl276\slmult1\cf0      \cf1 OBS: Para o calculo de R e S utilize fun\'e7\'f5es especificas que retornam os valores ao procedimento chamador.\cf0\par
\ul algoritmo\ulnone  CALCULA_EXPRESSAO\par
     \ul fun\'e7\'e3o\ulnone  \cf1 calculaR\cf0 (inteiro: A, inteiro: B): \ul inteiro\ulnone\par
          \ul inicio\par
\ulnone                \ul inteiro:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pow((A + B),2);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\ulnone      \ul fun\'e7\'e3o\ulnone  \cf1 calculaS\cf0 (inteiro: B, inteiro: C): \ul inteiro\ulnone\par
          \ul inicio\par
\ulnone                \ul inteiro:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pow((B + C),2);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  valorA, valorB, valorC;\par
          \ul escreva\ulnone ("Insira tr\'eas n\'fameros inteiros e positivos");\par
          \ul leia\ulnone (valorA, valorB, valorC);\par
          \ul escreva\ulnone ("O resultado da opera\'e7\'e3o \'e9 ", \cf1 (calculaR(\cf0 valorA, valorB\cf1 )+calculaS(\cf0 valorB, valorC\cf1 ))/2\cf0 );\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
8 - \cf1 Passando como par\'e2metros o primeiro termo e a raz\'e3o de uma progress\'e3o aritm\'e9tica, determinar por meio de um procedimento a soma dos seus primeiros cinco termos. \cf0\par
\ul algoritmo\ulnone  CALCULA_PA\par
     \ul procedimento\ulnone  somaTermos(real: termoI, real: razao)\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  termoN;\par
               termoN \f2\u8592?\f0\lang22  termoI + (4 * razao);\ul\par
\ulnone                \ul escreva\ulnone ("A soma dos cinco primeiros termos dessa progress\'e3o aritm\'e9tica \'e9 ", ((termoI + termoN)5)/2);\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  termo1, razao;\par
          \ul escreva\ulnone ("Informe o primeiro termo e a raz\'e3o de uma progress\'e3o aritm\'e9tica");\par
          leia(termo1, razao);\par
          somaTermos(termo1, razao);\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
9 - \cf1 Construa um procedimento que, tem como par\'e2metros de entrada dois pontos quaisquer no plano, P(\i x\i0 1\i , y\i0 1) e Q(\i x\i0 2\i , y\i0 2), escreva a dist\'e2ncia entre eles. A f\'f3rmula que efetua tal c\'e1lculo \'e9: \par

\pard\sa200\sl276\slmult1\qc D = \f2\u8730?\f0\lang1046 (\i\lang22 x\i0 2 - \i x1\i0\lang1046 )\'b2 + (\i\lang22 y\i0 2 - \i y1\i0\lang1046 )\'b2\cf0\lang22\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  CALCULA_EXPRESSAO\par
     \ul procedimento\ulnone  calculaExpressao(real: x1, real: y1, real: x2, real: y2)\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  conta;\par
               conta \f2\u8592?\f0\lang22  pow(x2 - x1, 2) + pow(y2 - y1, 2);\ul\par
\ulnone                \ul escreva\ulnone ("O resultado da express\'e3o \'e9 ", sqrt(conta));\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  ;\par
          \ul escreva\ulnone ("Informe as coordenadas dos 2 pontos, primeiro x e y do primeiro, e depois x e y do segundo");\par
          \ul leia\ulnone (valorXP, valorYP, valorXQ, valorYQ);\par
          calculaExpressao(valorXP, valorYP, valorXQ, valorYQ);\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
10 - \cf1 Fa\'e7a um programa que leia 3 valores (A, B e C) . Logo ap\'f3s sejam passados como par\'e2metro a um procedimento que verifica se eles formam ou n\'e3o um tri\'e2ngulo. Em caso positivo, calcular o per\'edmetro do tri\'e2ngulo em procedimento adequado e em caso negativo, calcular a \'e1rea do trap\'e9zio que tem A e B como base e C como altura, tamb\'e9m em procedimento adequado. Para qualquer um dos casos, deve ser apresentada uma mensagem correspondente.\cf0\par
\ul algoritmo\ulnone  VERIFICA_TRIANGULO\par
     \ul procedimento\ulnone  casoPositivo(real: valor1, real: valor2, real: valor3)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("O per\'edmetro do tri\'e2ngulo \'e9 ", valor1 + valor2 + valor3);\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\ulnone      \ul procedimento\ulnone  casoNegativo(real: base1, real: base2, real: altura)\par
          \ul inicio\par
\ulnone                \ul escreva\ulnone ("A \'e1rea do trap\'e9zio \'e9 ", ((base1 + base2)*altura)/2);\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\ulnone      \ul procedimento\ulnone  validaTriangulo(real: A, real: B, real: C)\par
          \ul inicio\par
\ulnone                \ul se\ulnone  (((B + C)  > A) E ((A + C)  > B) E ((A + B)  > C))) \ul ent\'e3o\par
\ulnone                     \ul escreva\ulnone ("Os valores informados formam um tri\'e2ngulo");\ul\par
\ulnone                     casoPositivo(A, B, C);\ul\par
\ulnone                \ul sen\'e3o\par
\ulnone                     \ul escreva\ulnone ("Os valores informados formam um tri\'e2ngulo, ent\'e3o de um trap\'e9zio com as medidas informadas");\ul\par
\ulnone                     casoNegativo(A, B, C););\par
               \ul fim-se;\ulnone\par
          \ul fim;\ulnone\par
     \ul fim-procedimento.\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  valorA, valorB, valorC;\par
          \ul escreva\ulnone ("Informe os valores dos lados do tri\'e2ngulo");\par
          \ul leia\ulnone (valorA, valorB, valorC);\par
          validaTriangulo(valorA, valorB, valorC);\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
11 - \cf1 Escrever um procedimento que, tem como par\'e2metros de entrada um valor em reais. Este procedimento calcula qual o menor n\'famero poss\'edvel de notas de 100, 50, 10, 5 e 1 em que o valor lido pode ser decomposto. Tal procedimento deve apresentar o valor lido e a rela\'e7\'e3o de notas necess\'e1rias.\cf0\par
\ul algoritmo\ulnone  DECOMPOR_BRASIL\par
     \ul procedimento\ulnone  decomporNotas(real: total)\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  notas100, notas50, notas10, notas5, notas1, total2, total3, total4;\par
               notas100 \f2\u8592?\f0\lang22  totalDIV100;\par
               total2 \f2\u8592?\f0\lang22  total - (notas100 * 100);\ul\par
\ulnone                notas50 \f2\u8592?\f0\lang22  total2DIV50;\par
               total3 \f2\u8592?\f0\lang22  total2 - (notas50 * 50);\ul\par
\ulnone                notas10 \f2\u8592?\f0\lang22  total3DIV10;\par
