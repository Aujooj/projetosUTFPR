\pard\sa200\sl276\slmult1\cf0\par
\ul algoritmo\ulnone  MEDIDA_ESCADA\par
     \ul fun\'e7\'e3o\ulnone  conta(real: parede, real: seno): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  parede/seno;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  altura, angulo;\par
          \ul escreva\ulnone ("Informe o seno do \cf1\'e2ngulo, e a altura da parede\cf0 ");\par
          \ul leia\ulnone (angulo, altura);\par
          escreva("A medida da escada \'e9 ", conta(altura, angulo));\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
