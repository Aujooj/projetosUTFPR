16 - \cf1 Juca da Silva comprou um saco de ra\'e7\'e3o com peso em quilos. Juca possui dois gatos para os quais fornece a quantidade de ra\'e7\'e3o em gramas. Fa\'e7a um programa que receba o peso do saco de ra\'e7\'e3o e a quantidade de ra\'e7\'e3o fornecida para cada gato. Calcule e mostre quanto restar\'e1 de ra\'e7\'e3o no saco ap\'f3s cinco dias.\cf0\par
\ul algoritmo\ulnone  RACAO_GATOS\par
     \ul fun\'e7\'e3o\ulnone  conta(inteiro: saco, inteiro: gato): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f3\lang1046  \f0\lang22 (((saco * 1000) / (gato * 2) - 5) * (gato * 2)) / 1000;\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul inteiro:\ulnone  peso_saco, quant_racao;\par
          \ul escreva\ulnone ("Informe o peso do saco de ra\'e7\'e3o, em kg, e a quantidade de ra\'e7\'e3o fornecida pra cada gato");\ul\par
\ulnone           \ul leia\ulnone (peso_saco, quant_racao);\par
          \ul escreva\ulnone ("Ap\'f3s cinco dias ainda restam ", conta(peso_saco, quant_racao), " kg de ra\'e7\'e3o");\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
17 - \cf1 Fa\'e7a um programa que calcule as raizes de uma equa\'e7\'e3o de 2\'b0 grau, dados os coeficientes a, b e c (parametros de entrada da fun\'e7\'e3o para o calculo do delta). Passando o delta como parametro para outra fun\'e7\'e3o, calcule X e Y ou apresente caso preciso que a equa\'e7\'e3o n\'e3o possui raizes reais.\cf0\par
\ul algoritmo\ulnone  EQUACAO_2GRAU\par
     \ul fun\'e7\'e3o\ulnone  bhaskara1(real: delta, real: a, real: b): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  (-b + sqrt(delta)) / (2 * a);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\ulnone\par
     \ul fun\'e7\'e3o\ulnone  bhaskara2(real: delta, real: a, real: b): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  (-b - sqrt(delta)) / (2 * a);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\ulnone\par
     \ul fun\'e7\'e3o\ulnone  calculaDelta(real: A, real: B, real: C): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pow(B, 2) - (4 * A * C);\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  valorA, valorB, ValorC, delta;\par
          \ul escreva\ulnone ("Informe os coeficientes a, b e c");\par
          \ul leia\ulnone (valorA, valorB, valorC);\par
          delta \f2\u8592?\f0\lang22  calculaDelta(valorA, valorB, valorC);\par
          \ul se\ulnone  (delta < 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("A equa\'e7\'e3o n\'e3o possui valores reais");\ul\par
\ulnone           \ul sen\'e3o se\ulnone  (delta = 0) \ul ent\'e3o\par
\ulnone                \ul escreva\ulnone ("A equa\'e7\'e3o possui apenas um resultado real ou possui dois resultados iguais (essas duas afirma\'e7\'f5es s\'e3o equivalentes), e ele \'e9: ", bhaskara(delta, valorA, valorB));\ul\par
\ulnone           \ul sen\'e3o\par
\ulnone                \ul escreva\ulnone ("A equa\'e7\'e3o possui dois resultados reais distintos, e eles s\'e3o: ", bhaskara1(delta, valorA, valorB), " e ", bhaskara2(delta, valorA, valorB));\ul\par
\ulnone           \ul fim-se;\ulnone\par
     \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
18 - \cf1 Sabe-se que: \par

\pard\fi568\sl276\slmult1 - 1 p\'e9 = 12 polegadas; \par
- 1 jarda = 3 p\'e9s; \par

\pard\fi568\sa200\sl276\slmult1 - 1 milha = 1.760 jardas.\par

\pard\fi284\sa200\sl276\slmult1 Fa\'e7a um programa que receba uma medida em p\'e9s, fa\'e7a as convers\'f5es a seguir e mostre os resultados em. \par

\pard\fi568\sl276\slmult1 a) polegadas; \par
b) jardas; \par

\pard\fi568\sa200\sl276\slmult1 c) milhas. \par

\pard\fi284\sa200\sl276\slmult1\tx284 Para cada convers\'e3o fa\'e7a sua respectiva fun\'e7\'e3o. \cf0\par

\pard\sa200\sl276\slmult1\ul algoritmo\ulnone  \par
     \ul fun\'e7\'e3o\ulnone  polegadas(real: pes): \ul real\ulnone  \par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pes * 12;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\ulnone      \ul fun\'e7\'e3o\ulnone  jardas(real: pes): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pes / 3;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\ulnone\par
     \ul fun\'e7\'e3o\ulnone  milhas(real: pes): \ul real\ulnone\par
          \ul inicio\par
\ulnone                \ul real:\ulnone  res;\par
               res \f2\u8592?\f0\lang1046  pes / \cf1\lang22 5280\cf0\lang1046 ;\lang22\par
               \ul retorna\ulnone  res;\par
          \ul fim;\ulnone\par
     \ul fim-fun\'e7\'e3o;\par
\{programa principal\}\par
\ulnone      \ul inicio\par
\ulnone           \ul real:\ulnone  valorPes;\par
          \ul escreva\ulnone ("Informe a medida em p\'e9s");\par
          \ul leia\ulnone (valorPes);\par
          \ul escreva\ulnone (pes, " p\'e9s correspondem a ", polegadas(valorPes), " polegadas");\par
          \ul escreva\ulnone (pes, " p\'e9s correspondem a ", jardas(valorPes), " jardas");\par
          \ul escreva\ulnone (pes, " p\'e9s correspondem a ", milhas(valorPes), " milhas");\ul\par
\ulnone      \ul fim;\par
fim-algoritmo.\ulnone\par
_____________________________________________________________________\par
